# Required: your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: any Pydantic AI model string. Haiku is cheaper and faster for demos.
# MODEL=anthropic:claude-sonnet-5-5
MODEL=anthropic:claude-haiku-5-5

# Optional: max context checks per client IP per 10 minutes
RATE_LIMIT_PER_10_MIN=20

# Optional: only needed if the front end calls this service directly instead of via the Netlify proxy
# ALLOWED_ORIGINS=https://your-site.netlify.app
